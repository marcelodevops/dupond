# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AEGIS_ALLOW_PRIVATE_PROVIDER_HOSTS: Set to "true" only when custom providers
# intentionally target local/LAN services (Ollama on loopback, vLLM on a private
# network). Without it, /api/custom-providers/* refuses loopback, RFC1918,
# link-local and cloud-metadata addresses.
AEGIS_ALLOW_PRIVATE_PROVIDER_HOSTS="false"

# AEGIS_STATE_FILE: Override the path to the server-held state file. Used by the
# test suite so credential tests never write into data/aegis_state.json.
# AEGIS_STATE_FILE="./data/aegis_state.json"
