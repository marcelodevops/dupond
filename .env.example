# ==============================================================================
# Dupond Orchestrator Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Authentication
# ------------------------------------------------------------------------------
# DUPOND_API_KEY takes precedence over DUPOND_AUTH_TOKEN.
# If neither is set, Dupond generates a secure token (dp_<hex>) and persists
# it in data/.dupond_auth_token with 0600 file permissions.
# All mutating and execution API endpoints require Authorization: Bearer <token>
# or X-Dupond-Token: <token>.
DUPOND_API_KEY=
DUPOND_AUTH_TOKEN=

# Distinct operator approval credential (recommended). Delivery-dispatch requests
# that approve a PR (isApproved: true) must additionally present this token via
# X-Dupond-Approval-Token. Without it, approval attempts over the API fail closed
# (503); delivery dispatches without approval are unaffected. Keep this token
# separate from DUPOND_API_KEY so execution callers cannot self-approve.
DUPOND_APPROVAL_TOKEN=

# ------------------------------------------------------------------------------
# 2. Coding Worker LLM Providers
# ------------------------------------------------------------------------------
# Google Gemini Provider
# Required when using Gemini coding workers (gemini-3.5-flash, gemini-3.8-flash).
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.5-flash"

# OpenAI Provider
# Required when using OpenAI coding workers (gpt-4o-mini, gpt-4o, o1, o3-mini).
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# 3. Server & Network Configuration
# ------------------------------------------------------------------------------
# HTTP port for the application server (default: 3000)
PORT=3000

# Set to "true" only when custom providers intentionally target local/LAN services
# (e.g. Ollama on loopback, vLLM on a private network). Without it, the orchestrator's
# SSRF egress filter strictly refuses loopback, RFC1918, link-local, and cloud metadata addresses.
DUPOND_ALLOW_PRIVATE_PROVIDER_HOSTS="false"

# ------------------------------------------------------------------------------
# 4. Storage & Persistence
# ------------------------------------------------------------------------------
# SQLite database path for authoritative task store, runs, verification records,
# and delivery audit records (default: ./data/dupond.db)
DUPOND_DB_PATH="./data/dupond.db"

# Path to the JSON sprint and UI telemetry state file (default: ./data/dupond_state.json)
DUPOND_STATE_FILE="./data/dupond_state.json"

# ------------------------------------------------------------------------------
# 5. Worktree & Target Repository Configuration
# ------------------------------------------------------------------------------
# Optional default filesystem path to target development repository
# DUPOND_TARGET_REPO="/path/to/target/repository"

# ------------------------------------------------------------------------------
# 6. Sandbox Isolation (Linux Containers)
# ------------------------------------------------------------------------------
# Container image used for Linux sandbox execution (default: node:22-bookworm)
DUPOND_SANDBOX_IMAGE="node:22-bookworm"

# ------------------------------------------------------------------------------
# 7. GitHub Delivery Integration
# ------------------------------------------------------------------------------
# GitHub personal access token for automated / headless CI pull request delivery.
# If unset, Dupond relies on the host's existing `gh` CLI credentials (gh auth login).
# GH_TOKEN=
# GITHUB_TOKEN=
